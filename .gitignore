# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local/personal variable files. terraform/envs/<env>.tfvars hold the shared,
# non-secret per-environment config and stay committed.
*.tfvars
*.tfvars.json
!terraform/envs/*.tfvars

# Keep the provider lock file so every run uses the same provider versions.
!.terraform.lock.hcl

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/
env/
.env

# ---------------------------------------------------------------------------
# IDE & OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
